# LinkSuwon - Environment Variables Template

# Flask Settings
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5001

# [API Keys]
# 1. Korea Tourism Organization TourAPI Decoding Key (한국관광공사 TourAPI 디코딩 인증키)
TOUR_API_KEY=your_tourapi_decoding_key_here

# 2. Naver Map API Client ID (네이버 지도 클라이언트 ID)
NAVER_CLIENT_ID=your_naver_map_client_id_here

# 3. Gemini REST API Key (제미나이 API 키)
GEMINI_API_KEY=your_gemini_api_key_here

# [Security & SSL Settings]
# 로컬 개발 환경에서는 'False', 실서비스 배포 환경에서는 반드시 'True'로 설정하십시오.
SSL_VERIFY=False
