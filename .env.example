# LinkSuwon - Environment Variables Template

# Flask Settings
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5001

# [API Keys]
# 1. Korea Tourism Organization TourAPI Decoding Key (한국관광공사 TourAPI 디코딩 인증키)
TOUR_API_KEY=your_tourapi_decoding_key_here

# 2. Naver Map API Client ID (네이버 지도 클라이언트 ID)
NAVER_CLIENT_ID=your_naver_map_client_id_here

# 3. NVIDIA Build API Key (GPT-OSS-20B)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# Runtime data paths. Keep production data outside the Git checkout.
# DATABASE_PATH=/home/ubuntu/data/linksuwon/linksuwon.db
# UPLOAD_FOLDER=/home/ubuntu/data/linksuwon/uploads
# UPLOAD_URL_PREFIX=/uploads

# 4. Google OAuth Client ID (구글 로그인 클라이언트 ID)
# 구글 클라우드 콘솔(https://console.cloud.google.com)에서 발급받은 웹 애플리케이션 클라이언트 ID를 설정합니다.
GOOGLE_CLIENT_ID=your_google_client_id_here


# [Security & SSL Settings]
SECRET_KEY=
SESSION_COOKIE_SECURE=False
# 로컬 개발 환경에서는 'False', 실서비스 배포 환경에서는 반드시 'True'로 설정하십시오.
SSL_VERIFY=False
